---
import BaseLayout from "./BaseLayout.astro";

interface Props {
  /** Markdown pages pass frontmatter through this prop automatically. */
  frontmatter?: { title: string; description: string; accent?: string };
  title?: string;
  description?: string;
  accent?: string;
}

const fm = Astro.props.frontmatter;
const title = fm?.title ?? Astro.props.title ?? "";
const description = fm?.description ?? Astro.props.description ?? "";
const accent = fm?.accent ?? Astro.props.accent ?? "blue";
---

<BaseLayout title={title} description={description}>
  <section class="page-head" data-accent={accent}>
    <div class="wrap">
      <h1 class="display page-title">{title}</h1>
      {description && <p class="lead page-lead">{description}</p>}
    </div>
  </section>

  <section class="wrap page-body">
    <div class="prose">
      <slot />
    </div>
  </section>
</BaseLayout>

<style>
  .page-head {
    padding-block: clamp(2.5rem, 6vw, 5rem) 0;
    position: relative;
  }

  .page-head::after {
    content: "";
    display: block;
    width: 5rem;
    height: 5rem;
    margin-top: 2.5rem;
    border-radius: 50%;
    background: var(--accent);
    border: var(--stroke) solid var(--c-dark);
  }

  .page-lead { margin-top: 1.5rem; color: var(--c-muted); }

  .page-body { padding-block: clamp(2rem, 4vw, 3rem) var(--section); }
</style>
