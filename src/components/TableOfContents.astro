---
import type { MarkdownHeading } from "astro";

interface Props {
  headings: MarkdownHeading[];
}

// Only h2/h3 — deeper levels make the rail noisy.
const headings = Astro.props.headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{
  headings.length > 1 && (
    <nav class="toc" aria-labelledby="toc-title">
      <p class="eyebrow" id="toc-title">
        On this page
      </p>
      <ul>
        {headings.map((h) => (
          <li class:list={["toc__item", { "toc__item--sub": h.depth === 3 }]}>
            <a href={`#${h.slug}`} data-toc-link={h.slug}>
              {h.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}

<style>
  .toc { position: sticky; top: 6.5rem; font-size: var(--fs-sm); }

  .toc ul { list-style: none; margin: 1rem 0 0; padding: 0; display: grid; gap: 0.1rem; }

  .toc__item--sub { padding-left: 1rem; }

  .toc a {
    display: block;
    padding: 0.35rem 0.6rem;
    border-radius: 0 6px 6px 0;
    border-left: 2px solid var(--c-grey);
    color: var(--c-muted);
    line-height: 1.35;
    transition: color 0.2s, background 0.2s, border-color 0.2s;
  }

  .toc a:hover { color: var(--c-dark); background: var(--c-grey-light); }

  .toc a[aria-current="true"] {
    color: var(--c-dark);
    font-weight: 600;
    border-color: var(--c-orange);
    background: var(--c-grey-light);
  }

  @media (max-width: 64rem) {
    .toc { display: none; }
  }
</style>

<script>
  // Highlight the heading currently in view.
  const links = new Map<string, HTMLAnchorElement>();
  document.querySelectorAll<HTMLAnchorElement>("[data-toc-link]").forEach((a) => {
    links.set(a.dataset.tocLink!, a);
  });

  if (links.size > 0) {
    const targets = [...links.keys()]
      .map((id) => document.getElementById(id))
      .filter((el): el is HTMLElement => el !== null);

    let active: string | null = null;

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          if (active) links.get(active)?.removeAttribute("aria-current");
          active = entry.target.id;
          links.get(active)?.setAttribute("aria-current", "true");
        }
      },
      // Trigger as a heading crosses the upper third of the viewport.
      { rootMargin: "-80px 0px -66% 0px", threshold: 0 }
    );

    targets.forEach((t) => observer.observe(t));
  }
</script>
