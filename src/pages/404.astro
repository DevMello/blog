---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Not found" description="That page doesn't exist." noindex>
  <section class="oops wrap">
    <p class="eyebrow">Error 404</p>
    <h1 class="display">This page went <span class="hl">missing</span>.</h1>
    <p class="lead">Either it moved, or it never existed. Both happen around here.</p>
    <div class="oops__actions">
      <a href="/" class="btn btn--solid" data-accent="pink">Back home <span class="btn__arrow">→</span></a>
      <a href="/blog" class="btn">Read something instead <span class="btn__arrow">→</span></a>
    </div>
  </section>
</BaseLayout>

<style>
  .oops {
    padding-block: clamp(4rem, 12vw, 10rem);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.5rem;
  }

  .hl { position: relative; white-space: nowrap; }
  .hl::before {
    content: "";
    position: absolute;
    inset: 0.1em -0.15em 0.12em;
    z-index: -1;
    background: var(--c-purple);
    border-radius: 0.4em;
    transform: rotate(-1.2deg);
  }

  .oops__actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1rem; }
</style>
